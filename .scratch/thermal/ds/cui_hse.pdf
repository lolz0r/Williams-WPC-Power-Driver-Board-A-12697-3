    <div id="notification-banner" class="bg-primary w-100 py-2 px-5 shadow text-small text-white text-center position-relative d-none">
    CUI Devices is now Same Sky! 🎉 Our mission remains the same: To nurture the spirit of innovation, but above all, be human. Our products, people, and resources aren't changing either.
    <br />
    <a href="/news/press-releases/cui-devices-has-a-new-name-say-hello-to-same-sky" class="text-white text-underline">
        Learn more in our press release.
    </a>
    <span id="notification-banner-close" class="icon-remove-x icon icon-white icon-xs"></span>
</div>

<script>
    const closeDateKey = 'notificationBannerCloseDate';
    const currentDate = new Date().getTime();
    const daysToCheck = 3 * 24 * 60 * 60 * 1000; // 3 days in milliseconds
    const storedCloseDate = localStorage.getItem(closeDateKey);

    // If the key doesn't exist or it's been more than 3 days, render the banner
    if (!storedCloseDate || currentDate >= parseInt(storedCloseDate, 10) + daysToCheck) {
        const banner = $('#notification-banner');
        banner.removeClass('d-none')

        // Event listener for close button
        $('#notification-banner-close').click(function () {
            banner.addClass('d-none')
            localStorage.setItem(closeDateKey, currentDate); // Set the current date in localStorage
        });
    }
</script>

