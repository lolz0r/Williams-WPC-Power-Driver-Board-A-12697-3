<script>

    var widgetID;

    $(document).on('click', '#subscribeButtonFooter', function (e) {
        e.preventDefault();
        $("#subscribeButtonFooter").prop("disabled", true);
        if (widgetID == null) {
            widgetID = renderFooterRecaptcha();
        }
        if (grecaptcha.getResponse(widgetID).length !== 0) {
            submitFooterForm();
        } else if (grecaptcha.getResponse(widgetID).length == 0) {
            grecaptcha.execute(widgetID);
        }
    });

    function renderFooterRecaptcha() {
        return grecaptcha.render('reCAPTCHAContainerFooter', {
                    'sitekey': '6Lf96SEqAAAAAIwDwuHeVSpqy62BeIbvyX0WOFlO',
                    'callback': submitFooterForm,
                    'size': 'invisible'
         });
    }

    function bindFooterFormSubmit() {
        var form = $("#ic_signupform_footer");
        $(form).on("submit", function (event) {
            event.preventDefault();
            var $this = $(this);

            var frmValues = $this.serialize();
            $.ajax({
                type: $this.attr('method'),
                url: $this.attr('action'),
                data: frmValues,
                success: function (result) {
                    $("#subscribeButtonFooter").prop("disabled", false);
                    widgetID = null;
                    dataLayer.push({
                        event: 'form_newsletter'
                    });
              
                    if (result.Success == true) {
                        window.location.href = result.Url;
                    } else {
                        $("#newsletterSignUpFooter").html(result);
                    }
                },
                error: function (textStatus, errorThrown) {
                    console.log(errorThrown);
                }

            }).done(function () {

                if ($(form).length > 0) {
                    bindFooterFormSubmit();//re-bind after partial form refresh
                }
            });

        });
    }

    function submitFooterForm(token) {
        $("#ic_signupform_footer").trigger('submit');
    }

    $(function () {
        bindFooterFormSubmit();
    });
</script>


