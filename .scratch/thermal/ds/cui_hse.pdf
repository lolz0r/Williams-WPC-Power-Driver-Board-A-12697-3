</header>

<script>
    // Navigation Search Autocomplete - Clean, simple implementation matching app patterns
    var NavigationSearch = (function() {
        'use strict';

        var CONFIG = {
            selectors: { input: '.navigation-search-autocomplete', form: '.search-form' },
            classes: {
                results: 'autocomplete-results',
                item: 'autocomplete-item',
                selected: 'selected',
                content: 'autocomplete-content',
                title: 'autocomplete-title',
                description: 'autocomplete-description'
            },
            keys: { UP: 38, DOWN: 40, ENTER: 13, ESCAPE: 27 },
            api: {
                url: '/AutoComplete/NavigationSearchAutoComplete',
                recommendationsUrl: '/AutoComplete/GetSearchRecommendations',
                minLength: 2,
                timeout: 10000
            },
            timing: { searchDelay: 300, hideDelay: 150 },
            storage: { recentSearchesKey: 'samesky-recent-searches', maxRecentItems: 5 }
        };

        var state = {
            $input: null,
            $results: null,
            results: [],
            selectedIndex: -1,
            searchTimeout: null,
            currentRequest: null,
            initialized: false,
            originalThreeColumnData: null // Cache original three-column structure
        };

        var utils = {
            isValid: function(val) {
                return val && typeof val === 'string' && val.trim() !== '';
            },

            escapeRegex: function(str) {
                return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            },

            highlight: function(text, term) {
                if (!text || !term) return text;
                var regex = new RegExp('(' + utils.escapeRegex(term) + ')', 'gi');
                return text.replace(regex, '<mark class="search-highlight">$1</mark>');
            },

            debounce: function(func, wait) {
                return function() {
                    var context = this, args = arguments;
                    clearTimeout(state.searchTimeout);
                    state.searchTimeout = setTimeout(function() {
                        func.apply(context, args);
                    }, wait);
                };
            },

            // Recent searches localStorage management
            getRecentSearches: function() {
                try {
                    var stored = localStorage.getItem(CONFIG.storage.recentSearchesKey);
                    return stored ? JSON.parse(stored) : [];
                } catch (e) {
                    return [];
                }
            },

            addRecentSearch: function(searchTerm) {
                if (!utils.isValid(searchTerm) || searchTerm.length < 2) return;

                try {
                    var recent = utils.getRecentSearches();
                    var term = searchTerm.trim().toLowerCase();

                    // Remove if already exists, add to beginning, keep max items
                    recent = recent.filter(function(item) {
                        return item.toLowerCase() !== term;
                    });
                    recent.unshift(searchTerm.trim());
                    recent = recent.slice(0, CONFIG.storage.maxRecentItems);

                    localStorage.setItem(CONFIG.storage.recentSearchesKey, JSON.stringify(recent));
                } catch (e) {
                    console.warn('Could not save recent search:', e);
                }
            },

            createRecentSearchResults: function() {
                var recent = utils.getRecentSearches();
                return recent.map(function(term) {
                    return {
                        label: term,
                        value: term,
                        type: 'recent',
                        category: '',
                        description: '',
                        source: 'recent',
                        url: '',
                        searchTerm: ''
                    };
                });
            }
        };

        var dom = {
            createResults: function() {
                if (state.$results) state.$results.remove();
                state.$results = $('<div class="' + CONFIG.classes.results + '" role="listbox" aria-label="Search suggestions"></div>');
                state.$input.parent().append(state.$results);
            },

            createItem: function(item, index) {
                var label = item.Label || item.label || '';
                var description = item.Description || item.description || '';
                var category = item.Category || item.category || '';
                var searchTerm = item.SearchTerm || item.searchTerm || '';
                var type = item.Type || item.type || '';

                // Apply highlighting - simple text processing like Super Search
                var highlighted = {
                    label: searchTerm ? utils.highlight(label, searchTerm) : label,
                    desc: description && searchTerm ? utils.highlight(description, searchTerm) : description,
                    cat: category && searchTerm ? utils.highlight(category, searchTerm) : category
                };

                var $item = $('<div class="' + CONFIG.classes.item + '" data-index="' + index + '" role="option" id="autocomplete-item-' + index + '"></div>');
                var $container = $('<div class="autocomplete-item-enhanced"></div>');
                var $content = $('<div class="' + CONFIG.classes.content + '"></div>');

                // Set title content using .html() for proper rendering
                $content.append('<div class="' + CONFIG.classes.title + '"></div>');
                $content.find('.' + CONFIG.classes.title).html(highlighted.label);

                // Add description for all items (no special handling for recent items)
                if (highlighted.desc) {
                    $content.append('<div class="' + CONFIG.classes.description + '"></div>');
                    $content.find('.' + CONFIG.classes.description).html(highlighted.desc);
                }

                $container.append($content);
                $item.append($container);

                $item.on('click', function() { actions.select(item); });
                $item.on('mouseenter', function() {
                    // Only update visual highlight, don't set selectedIndex for keyboard navigation
                    state.$results.find('.' + CONFIG.classes.item).removeClass(CONFIG.classes.selected);
                    $(this).addClass(CONFIG.classes.selected);
                });
                $item.on('mouseleave', function() {
                    // Clear mouse-based highlighting when mouse leaves
                    $(this).removeClass(CONFIG.classes.selected);
                    // Restore keyboard selection if there is one
                    if (state.selectedIndex >= 0) {
                        state.$results.find('[data-index="' + state.selectedIndex + '"]').addClass(CONFIG.classes.selected);
                    }
                });

                return $item;
            },

            createSectionHeader: function(title) {
                return $('<div class="autocomplete-section-header">' + title + '</div>');
            }
        };

        var actions = {
            select: function(item) {
                try {
                    state.$input.addClass('loading');
                    var value = item.Value || item.value || '';
                    var type = item.Type || item.type || '';
                    var source = item.Source || item.source || '';
                    var url = item.Url || item.url || '';

                    // GA4 tracking for dropdown clicks
                    if (typeof dataLayer !== 'undefined') {
                        dataLayer.push({
                            event: 'site_search_dropdown_click',
                            search_term: value,
                            search_result_type: type,
                            search_result_source: source
                        });
                    }

                    // Save to recent searches (except for recent items themselves)
                    if (value && type !== 'recent') {
                        utils.addRecentSearch(value);
                    }

                    // Try direct URL navigation first, then fallback to form submission
                    if (url && utils.isValid(url) && (source === 'addsearch' || source === 'database' || source === 'fallback')) {
                        window.location.href = url;
                        return;
                    }

                    // Form submission fallback
                    var $form = state.$input.closest(CONFIG.selectors.form);
                    if ($form.length && utils.isValid(value)) {
                        $form.find('input[name="partnumber"]').val(value);
                        $form.submit();
                    }
                } catch (error) {
                    console.error('Error selecting item:', error);
                    state.$input.removeClass('loading');
                    var value = item.Value || item.value || '';
                    if (utils.isValid(value)) state.$input.val(value);
                }
            }
        };

        var selection = {
            update: function(index) {
                if (index !== undefined) state.selectedIndex = index;

                state.$results.find('.' + CONFIG.classes.item)
                    .removeClass(CONFIG.classes.selected)
                    .attr('aria-selected', 'false');

                if (state.selectedIndex >= 0) {
                    var $selected = state.$results.find('[data-index="' + state.selectedIndex + '"]')
                        .addClass(CONFIG.classes.selected)
                        .attr('aria-selected', 'true');
                    state.$input.attr('aria-activedescendant', $selected.attr('id'));
                }
            },

            navigate: function(direction) {
                var count = state.results.length;
                if (direction === 'up') {
                    state.selectedIndex = state.selectedIndex <= 0 ? count - 1 : state.selectedIndex - 1;
                } else {
                    state.selectedIndex = state.selectedIndex >= count - 1 ? 0 : state.selectedIndex + 1;
                }
                selection.update();
            }
        };

        var results = {
            show: function(data) {
                if (!data || data.length === 0) {
                    results.hide();
                    return;
                }

                // Check if this is three-column format
                if (data.Suggestions !== undefined || data.Products !== undefined || data.Content !== undefined) {
                    results.showThreeColumn(data);
                    return;
                }

                // Single-column format
                state.results = data;
                state.selectedIndex = -1;

                if (!state.$results) dom.createResults();
                state.$results.empty().show();

                // Group and display results by type
                var grouped = { recent: [], recommendations: [], searches: [] };
                data.forEach(function(item) {
                    if (item.type === 'recent') grouped.recent.push(item);
                    else if (item.type === 'recommendation') grouped.recommendations.push(item);
                    else grouped.searches.push(item);
                });

                var currentIndex = 0;

                // Add sections with headers
                if (grouped.recent.length > 0) {
                    state.$results.append(dom.createSectionHeader('Recent Searches'));
                    grouped.recent.forEach(function(item) {
                        item.globalIndex = currentIndex++;
                        state.$results.append(dom.createItem(item, item.globalIndex));
                    });
                }

                if (grouped.recommendations.length > 0) {
                    state.$results.append(dom.createSectionHeader('Recommended'));
                    grouped.recommendations.forEach(function(item) {
                        item.globalIndex = currentIndex++;
                        state.$results.append(dom.createItem(item, item.globalIndex));
                    });
                }

                if (grouped.searches.length > 0 && (grouped.recent.length > 0 || grouped.recommendations.length > 0)) {
                    state.$results.append(dom.createSectionHeader('Search Results'));
                }
                grouped.searches.forEach(function(item) {
                    item.globalIndex = currentIndex++;
                    state.$results.append(dom.createItem(item, item.globalIndex));
                });

                state.$input.attr('aria-expanded', 'true');
            },

            showThreeColumn: function(data) {
                // Flatten results for keyboard navigation and set search terms
                var allResults = [];
                var currentSearchTerm = state.$input.val().trim();

                ['Suggestions', 'Products', 'Content'].forEach(function(columnName) {
                    if (data[columnName] && data[columnName].length > 0) {
                        data[columnName].forEach(function(item) {
                            item.SearchTerm = item.SearchTerm || currentSearchTerm;
                            item.searchTerm = item.searchTerm || currentSearchTerm;
                            allResults.push(item);
                        });
                    }
                });

                state.results = allResults;
                state.selectedIndex = -1;

                if (!state.$results) dom.createResults();

                // Setup three-column layout
                state.$results.empty().removeClass().addClass(CONFIG.classes.results + ' three-column-layout').show();

                var $threeColumnContainer = $('<div class="autocomplete-three-column-container"></div>');
                var currentIndex = 0;

                // Determine which columns have content for responsive layout
                var columnsWithResults = [];
                var columnData = [
                    { name: 'Suggestions', data: data.Suggestions, class: 'suggestions-column' },
                    { name: 'Products', data: data.Products, class: 'products-column' },
                    { name: 'Content', data: data.Content, class: 'content-column' }
                ];

                columnData.forEach(function(col) {
                    if (col.data && col.data.length > 0) {
                        columnsWithResults.push(col);
                    }
                });

                // If no results in any column, show special "No suggestions found" message
                if (columnsWithResults.length === 0) {
                    state.$results.empty().removeClass().addClass(CONFIG.classes.results + ' no-suggestions-layout').show();
                    var $noSuggestionsContainer = $('<div class="autocomplete-no-suggestions-container"></div>');
                    $noSuggestionsContainer.append('<div class="autocomplete-no-suggestions-message">No suggestions found. Press enter to search.</div>');
                    state.$results.append($noSuggestionsContainer);
                    state.$input.attr('aria-expanded', 'true');
                    return;
                }

                // Apply responsive column classes based on number of visible columns
                var containerClass = 'columns-' + Math.max(columnsWithResults.length, 1);
                $threeColumnContainer.addClass(containerClass);

                // Create each visible column
                columnsWithResults.forEach(function(col) {
                    var $column = $('<div class="autocomplete-column ' + col.class + '"></div>');
                    $column.append('<div class="autocomplete-column-header">' + col.name + '</div>');

                    if (col.data && col.data.length > 0) {
                        col.data.forEach(function(item) {
                            item.globalIndex = currentIndex++;
                            $column.append(dom.createItem(item, item.globalIndex));
                        });
                    } else {
                        $column.append('<div class="autocomplete-no-results">No ' + col.name.toLowerCase() + ' found</div>');
                    }

                    $threeColumnContainer.append($column);
                });

                state.$results.append($threeColumnContainer);
                state.$input.attr('aria-expanded', 'true');
            },

            hide: function() {
                if (state.$results) {
                    state.$results.hide().empty();
                }
                state.selectedIndex = -1;
                state.$input.attr({ 'aria-expanded': 'false', 'aria-activedescendant': '' });
            },

            showRecentAndRecommendations: function() {
                var recentSearches = utils.createRecentSearchResults();

                // Load recommendations, then combine with recent searches for single display
                api.loadRecommendations(function(recommendations) {
                    var combined = [];

                    // Add recent searches (up to 3), then recommendations to fill remaining slots
                    if (recentSearches.length > 0) {
                        combined = combined.concat(recentSearches.slice(0, 3));
                    }

                    if (recommendations && recommendations.length > 0) {
                        var remainingSlots = Math.max(0, 8 - combined.length);
                        combined = combined.concat(recommendations.slice(0, remainingSlots));
                    }

                    // Single display operation to prevent flash
                    if (combined.length > 0) {
                        results.show(combined);
                    } else {
                        results.hide();
                    }
                });
            }
        };

        var api = {
            search: utils.debounce(function(text) {
                if (!utils.isValid(text) || text.length < CONFIG.api.minLength) {
                    results.hide();
                    return;
                }

                if (state.currentRequest) state.currentRequest.abort();

                state.$input.addClass('loading');
                state.currentRequest = $.ajax({
                    url: CONFIG.api.url,
                    type: 'POST',
                    dataType: 'json',
                    timeout: CONFIG.api.timeout,
                    data: { searchText: text },
                    success: function(data) {
                        try {
                            if (data && (data.Suggestions !== undefined || data.Products !== undefined || data.Content !== undefined)) {
                                // Three-column format - cache BOTH the original structure AND flattened results
                                var flattened = [];
                                ['Suggestions', 'Products', 'Content'].forEach(function(columnName) {
                                    if (data[columnName] && data[columnName].length > 0) {
                                        data[columnName].forEach(function(item) {
                                            item.SearchTerm = item.SearchTerm || text;
                                            item.searchTerm = item.searchTerm || text;
                                            flattened.push(item);
                                        });
                                    }
                                });

                                // Cache BOTH formats for different use cases
                                state.results = flattened; // For keyboard navigation
                                state.originalThreeColumnData = data; // Cache original structure for focus event
                                results.show(data);
                            } else if (data && $.isArray(data) && data.length > 0) {
                                // Legacy single-column format
                                var processed = $.map(data, function(item) {
                                    return {
                                        label: item.Label || '',
                                        value: item.Value || '',
                                        type: item.Type || '',
                                        category: item.Category || '',
                                        description: item.Description || '',
                                        source: item.Source || '',
                                        url: item.Url || '',
                                        searchTerm: text
                                    };
                                });
                                state.results = processed;
                                state.originalThreeColumnData = null; // Clear three-column cache
                                results.show(processed);
                            } else {
                                state.results = [];
                                state.originalThreeColumnData = null;
                                results.hide();
                            }
                        } catch (error) {
                            console.error('Error processing results:', error);
                            state.results = [];
                            state.originalThreeColumnData = null;
                            results.hide();
                        }
                    },
                    error: function(xhr, status, error) {
                        if (status !== 'abort') console.error('Search failed:', error, xhr.responseText);
                        state.results = [];
                        state.originalThreeColumnData = null;
                        results.hide();
                    },
                    complete: function() {
                        state.$input.removeClass('loading');
                        state.currentRequest = null;
                    }
                });
            }, CONFIG.timing.searchDelay),

            loadRecommendations: function(callback) {
                var recentSearches = utils.getRecentSearches();
                var formData = {};

                for (var i = 0; i < recentSearches.length; i++) {
                    formData['recentSearches[' + i + ']'] = recentSearches[i];
                }

                $.ajax({
                    url: CONFIG.api.recommendationsUrl,
                    type: 'POST',
                    dataType: 'json',
                    timeout: CONFIG.api.timeout,
                    data: formData,
                    success: function(data) {
                        try {
                            if (data && $.isArray(data)) {
                                var processed = $.map(data, function(item) {
                                    return {
                                        label: item.Label || item.Value || '',
                                        value: item.Value || item.Label || '',
                                        type: item.Type || 'recommendation',
                                        category: item.Category || '',
                                        description: item.Description || '',
                                        source: item.Source || 'addsearch',
                                        url: item.Url || '',
                                        searchTerm: ''
                                    };
                                });
                                callback(processed);
                            } else {
                                callback([]);
                            }
                        } catch (error) {
                            console.error('Error processing recommendations:', error);
                            callback([]);
                        }
                    },
                    error: function() {
                        callback([]);
                    }
                });
            }
        };

        var events = {
            onInput: function() {
                var text = state.$input.val().trim();

                // Only clear selection when user types, but don't interfere with results loading
                if (state.selectedIndex >= 0) {
                    state.selectedIndex = -1;
                    // Don't call selection.update() here as it might interfere with results display
                    state.$results.find('.' + CONFIG.classes.item)
                        .removeClass(CONFIG.classes.selected)
                        .attr('aria-selected', 'false');
                }

                if (text.length > 0) {
                    api.search(text);
                } else {
                    results.showRecentAndRecommendations();
                }
            },

            onKeydown: function(e) {
                switch(e.which) {
                    case CONFIG.keys.UP:
                    case CONFIG.keys.DOWN:
                        if (state.$results && state.$results.is(':visible') && state.results.length > 0) {
                            e.preventDefault();
                            selection.navigate(e.which === CONFIG.keys.UP ? 'up' : 'down');
                        }
                        break;

                    case CONFIG.keys.ENTER:
                        e.preventDefault();
                        if (state.$results && state.$results.is(':visible') &&
                            state.selectedIndex >= 0 && state.results[state.selectedIndex]) {
                            // Item selected via keyboard navigation - use it
                            actions.select(state.results[state.selectedIndex]);
                        } else {
                            // No keyboard selection or mouse-only hover - do site search
                            var searchText = state.$input.val().trim();
                            if (searchText.length > 0) {
                                if (typeof dataLayer !== 'undefined') {
                                    dataLayer.push({
                                        event: 'site_search',
                                        search_term: searchText,
                                        search_method: 'enter_key'
                                    });
                                }

                                state.$input.addClass('loading');
                                utils.addRecentSearch(searchText);
                                var $form = state.$input.closest(CONFIG.selectors.form);
                                if ($form.length) {
                                    $form.find('input[name="partnumber"]').val(searchText);
                                    $form.submit();
                                }
                            }
                        }
                        break;

                    case CONFIG.keys.ESCAPE:
                        results.hide();
                        break;
                }
            },

            onBlur: function() {
                setTimeout(results.hide, CONFIG.timing.hideDelay);
            },

            onFocus: function() {
                var text = state.$input.val().trim();
                if (text.length >= CONFIG.api.minLength) {
                    // First check if we have cached original three-column data
                    if (state.originalThreeColumnData) {
                        // Use the cached original three-column structure directly
                        results.showThreeColumn(state.originalThreeColumnData);
                    } else if (state.results.length > 0) {
                        // Fallback: Try to reconstruct from flattened results
                        var hasThreeColumnData = state.results.some(function(item) {
                            var type = item.Type || item.type;
                            return type === 'product' || type === 'resource' || type === 'category' || type === 'suggestion';
                        });

                        if (hasThreeColumnData) {
                            // Reconstruct three-column format from flattened results
                            var threeColumnData = {
                                Suggestions: state.results.filter(function(item) {
                                    var type = item.Type || item.type;
                                    return type === 'category' || type === 'suggestion' || type === 'marketing';
                                }),
                                Products: state.results.filter(function(item) {
                                    return (item.Type || item.type) === 'product';
                                }),
                                Content: state.results.filter(function(item) {
                                    return (item.Type || item.type) === 'resource';
                                })
                            };
                            results.showThreeColumn(threeColumnData);
                        } else {
                            // Show single-column cached results
                            results.show(state.results);
                        }
                    } else {
                        // No cached data - trigger fresh search
                        api.search(text);
                    }
                } else if (text.length === 0) {
                    // Empty field - show recent searches and recommendations
                    results.showRecentAndRecommendations();
                }
            },

            onResize: utils.debounce(function() {
                if (state.$results && state.$results.is(':visible')) {
                    dom.createResults();
                    if (state.results.length > 0) results.show(state.results);
                }
            }, 250)
        };

        return {
            init: function() {
                if (state.initialized) return;

                state.$input = $(CONFIG.selectors.input);
                if (!state.$input.length) {
                    console.warn('Navigation search input not found');
                    return;
                }

                // Set accessibility attributes
                state.$input.attr({
                    'autocomplete': 'off',
                    'role': 'combobox',
                    'aria-expanded': 'false',
                    'aria-haspopup': 'listbox',
                    'aria-autocomplete': 'list'
                });

                // Bind events
                state.$input.on({
                    'input': events.onInput,
                    'keydown': events.onKeydown,
                    'blur': events.onBlur,
                    'focus': events.onFocus
                });

                $(window).on('resize', events.onResize);
                state.initialized = true;
            },

            destroy: function() {
                if (!state.initialized) return;

                // Clean up
                if (state.$input) state.$input.off();
                $(window).off('resize', events.onResize);
                if (state.$results) state.$results.remove();
                if (state.currentRequest) state.currentRequest.abort();
                if (state.searchTimeout) clearTimeout(state.searchTimeout);

                // Reset state
                Object.keys(state).forEach(function(key) { state[key] = null; });
                state.initialized = false;
            }
        };
    })();

    // Global utility functions and configuration
    var SiteDomain = {
        isJapan: function() {
            var supportedDomains = [
                'www.sameskydevices.com',
                'test.sameskydevices.com',
                'stage.sameskydevices.com',
                'redesign-test.sameskydevices.com'
            ];

            return !supportedDomains.some(function(domain) {
                return window.location.hostname === domain || window.location.hostname.includes('localhost');
            });
        }
    };

    var isJapan = SiteDomain.isJapan();

    function OneLink(sHostname) {
        var gaDomain = "www.sameskydevices.com";
        var url = document.location.protocol + "//" + sHostname;

        var cookieDomain = location.hostname.split('.').length > 1 ?
                          location.hostname.split('.').slice(-2).join('.') :
                          location.hostname;

        $.cookie("DefaultLang" + gaDomain, url, { domain: cookieDomain });
        document.location.href = url + document.location.pathname + document.location.search;
    }

    function preventEmptySubmit() {
        var searchValue = $(".navigation-search-autocomplete").val().trim();

        if (searchValue !== "" && typeof dataLayer !== 'undefined') {
            dataLayer.push({
                event: 'site_search',
                search_term: searchValue,
                search_method: 'form_submit'
            });
        }

        return searchValue !== "";
    }

    async function getCart() {
        try {
            const response = await DigiKeyCart.getCart();
            updateCartCount(response);
            syncProductsInCartToLS(response);
        } catch (error) {
            console.error('Error getting cart:', error);
        }
    }


    // Mega menu height management module
    var MegaMenuHeightManager = (function() {
        'use strict';

        var elements = {
            productsSubnavDiv: null,
            connectorsSubnavLink: null,
            connectorsSubnav: null,
            resourcesSubnavDiv: null,
            resourceLibrarySubnavLink: null,
            megaMenuMultiLevelDiv: null
        };

        var config = {
            resourceLibraryHeight: '296px'
        };

        function initializeElements() {
            elements.productsSubnavDiv = $('#products-subnav-div');
            elements.connectorsSubnavLink = $('#connectors-subnav-list-item');
            elements.connectorsSubnav = $('#connectors-subnav');
            elements.resourcesSubnavDiv = $('#resources-subnav-div');
            elements.resourceLibrarySubnavLink = $('#resource-library-subnav-list-item');
            elements.megaMenuMultiLevelDiv = $(".mega-menu--multiLevel-div");
        }

        function enlargeNavHeightForConnectors() {
            if (elements.connectorsSubnav && elements.connectorsSubnav.length &&
                elements.productsSubnavDiv && elements.productsSubnavDiv.length) {
                var connectorsSubnavHeight = elements.connectorsSubnav.height();
                if (connectorsSubnavHeight > 0) {
                    elements.productsSubnavDiv.height(connectorsSubnavHeight);
                }
            }
        }

        function enlargeNavHeightForResourceLibrary() {
            if (elements.resourcesSubnavDiv && elements.resourcesSubnavDiv.length) {
                elements.resourcesSubnavDiv.height(config.resourceLibraryHeight);
            }
        }

        function resetNavHeight() {
            // Reset all modified elements to their natural height
            if (elements.megaMenuMultiLevelDiv && elements.megaMenuMultiLevelDiv.length) {
                elements.megaMenuMultiLevelDiv.css("height", "auto");
            }
            if (elements.productsSubnavDiv && elements.productsSubnavDiv.length) {
                elements.productsSubnavDiv.css("height", "auto");
            }
            if (elements.resourcesSubnavDiv && elements.resourcesSubnavDiv.length) {
                elements.resourcesSubnavDiv.css("height", "auto");
            }
        }

        return {
            init: initializeElements,

            enableHoverEvents: function() {
                if (!elements.productsSubnavDiv) {
                    initializeElements();
                }

                if (elements.connectorsSubnavLink && elements.connectorsSubnavLink.length) {
                    elements.connectorsSubnavLink.hover(enlargeNavHeightForConnectors, resetNavHeight);
                }
                if (elements.resourceLibrarySubnavLink && elements.resourceLibrarySubnavLink.length) {
                    elements.resourceLibrarySubnavLink.hover(enlargeNavHeightForResourceLibrary, resetNavHeight);
                }
            },

            disableHoverEvents: function() {
                if (elements.connectorsSubnavLink && elements.connectorsSubnavLink.length) {
                    elements.connectorsSubnavLink.off('hover');
                }
                if (elements.resourceLibrarySubnavLink && elements.resourceLibrarySubnavLink.length) {
                    elements.resourceLibrarySubnavLink.off('hover');
                }
            }
        };
    })();

    // Legacy function for backwards compatibility
    function initializeMegaMenuElements() {
        MegaMenuHeightManager.init();
    }

    // Legacy function for backwards compatibility
    function addRemoveHoverEvent(addHoverEvent = true) {
        if (addHoverEvent) {
            MegaMenuHeightManager.enableHoverEvents();
        } else {
            MegaMenuHeightManager.disableHoverEvents();
        }
    }

    $(document).ready(function () {
        // Initialize navigation search autocomplete
        NavigationSearch.init();

        // Show/hide nav ads on menu item hover
        $('#navbarMenu [data-nav-link-id]').on('mouseenter', function () {
            var linkId = $(this).data('nav-link-id');
            var $adContainer = $(this).closest('.mega-menu').find('.featured-ad');
            $adContainer.find('.nav-ad-panel').hide();
            $adContainer.find('[data-nav-link="' + linkId + '"]').show();
        });
        $('.mega-menu').on('mouseleave', function () {
            $(this).find('.nav-ad-panel').hide();
        });

        // Initialize DigiKey cart for non-Japan sites
        if (!isJapan) {
            try {
                DigiKeyCart.initialize(window.location.origin + "/cart",
                    'EUH46pTOPyiexkF2ICfPIg5x788vYhfL');
                getCart();
            } catch (error) {
                console.error('Error initializing DigiKey cart:', error);
            }
        }

        // Initialize mega menu elements after DOM is ready
        initializeMegaMenuElements();

        // Responsive navigation setup
        var breakpoint = 1075;
        var previousWidth = $(window).width();

        // Set initial hover events for desktop view
        if (previousWidth > breakpoint) {
            addRemoveHoverEvent(true);
        }

        // Handle responsive navigation on window resize
        $(window).resize(function () {
            var newWidth = $(window).width();

            // Add hover events when switching from mobile to desktop
            if (newWidth > breakpoint && previousWidth <= breakpoint) {
                addRemoveHoverEvent(true);
            }
            // Remove hover events when switching from desktop to mobile
            else if (newWidth <= breakpoint && previousWidth > breakpoint) {
                addRemoveHoverEvent(false);
            }

            previousWidth = newWidth;
        });
    });
</script>

