<script>
    var lcfilesToUpload = []; // Array to store files
    var lcfileInput = document.querySelector('input#liveChat-files');
    lcfileInput.addEventListener('change', (e) => {
        for (let i = 0; i < e.target.files.length; i++) {
            let myFile = e.target.files[i];
            if (myFile.size && myFile.size >= 10485760) { // 10MB limit
                // show error                
                $('#lc-file-validation').show();                
            } else {
                let myFileID = "LCFID" + (1000 + Math.random() * 9000).toFixed(0);

                lcfilesToUpload.push({
                    file: myFile,
                    FID: myFileID
                });
            }            
        };
        lcdisplay();
        //reset the input to null - nice little chrome bug!
        e.target.value = null;
    });

    function lcremoveFile(x) {
        for (let i = 0; i < lcfilesToUpload.length; i++) {
            if (lcfilesToUpload[i].FID === x)
                lcfilesToUpload.splice(i, 1);
        }
        lcdisplay();
    }

    function lcdisplay() {
        document.getElementById("liveChat-myFiles").innerHTML = "";
        for (let i = 0; i < lcfilesToUpload.length; i++) {
            document.getElementById("liveChat-myFiles").innerHTML +=
                `<li>${lcfilesToUpload[i].file.name}
                <span class="icon-xs icon icon-remove-x ml-2 cursor-pointer" onclick="lcremoveFile('${lcfilesToUpload[i].FID}')" title="Remove File"></span>
            </li>`;
        }
    }

    function renderLCRecaptcha() {
        var fileIsOkay = true;
        $('#lc-file-validation').hide();
        var file = $('#liveChat-files')[0];
        if (file.files && file.files.length > 0) {
            if (file.files[0].size && file.files[0].size >= 10485760) { // 10MB limit
                // show error                
                $('#lc-file-validation').show();
                fileIsOkay = false;
            }
        }

        if (fileIsOkay) {
            return grecaptcha.render('reCAPTCHAContainer', {
                'sitekey': '6Lf96SEqAAAAAIwDwuHeVSpqy62BeIbvyX0WOFlO',
                'callback': submitLCForm,
                'size': 'invisible'
            });
        }
    }

</script>
