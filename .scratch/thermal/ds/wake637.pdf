}
.wakefield-comparison h1 {
  margin: 0 0 20px !important;
  font-size: clamp(2rem, 4vw, 3.1rem) !important;
}
.wakefield-comparison h2 {
  margin: 42px 0 14px !important;
  font-size: clamp(1.5rem, 3vw, 2.15rem) !important;
}
.wakefield-comparison h3 {
  margin: 0 0 10px !important;
  font-size: 1.15rem !important;
}
.wakefield-comparison p {
  margin: 0 0 16px !important;
  color: #242b31 !important;
  font-size: 16px !important;
  line-height: 1.65 !important;
}
.wakefield-comparison a:not(.wf-button) {
  color: #1f4e79 !important;
  text-decoration: underline !important;
  text-underline-offset: 2px !important;
}
.wakefield-comparison a:not(.wf-button):hover,
.wakefield-comparison a:not(.wf-button):focus {
  color: #123b5d !important;
  text-decoration: underline !important;
  text-decoration-thickness: 2px !important;
}
.wakefield-comparison .wf-intro {
  max-width: 980px !important;
  font-size: 1.05rem !important;
}
.wakefield-comparison .wf-callout {
  display: block !important;
  margin: 28px 0 8px !important;
  padding: 22px 24px !important;
  border: 0 !important;
  border-left: 5px solid #1f4e79 !important;
  border-radius: 0 !important;
  background: #edf4f8 !important;
  box-shadow: none !important;
}
.wakefield-comparison .wf-callout p {
  margin: 0 0 14px !important;
  color: #1f4e79 !important;
  font-weight: 700 !important;
}
.wakefield-comparison .wf-button {
  display: inline-block !important;
  width: auto !important;
  margin: 0 !important;
  padding: 12px 20px !important;
  border: 2px solid #1f4e79 !important;
  border-radius: 3px !important;
  background: #1f4e79 !important;
  color: #ffffff !important;
  font-family: Arial, Helvetica, sans-serif !important;
