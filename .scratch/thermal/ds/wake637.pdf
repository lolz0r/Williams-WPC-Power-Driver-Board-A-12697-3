  font-weight: 700 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  text-transform: none !important;
  box-shadow: none !important;
}
.wakefield-comparison .wf-button:hover,
.wakefield-comparison .wf-button:focus {
  border-color: #123b5d !important;
  background: #123b5d !important;
  color: #ffffff !important;
  text-decoration: none !important;
}
.wakefield-comparison .wf-table-wrap {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  margin: 20px 0 12px !important;
  overflow-x: auto !important;
  border: 1px solid #d7e0e7 !important;
  background: #ffffff !important;
  -webkit-overflow-scrolling: touch !important;
}
.wakefield-comparison .wf-table {
  width: 100% !important;
  min-width: 900px !important;
  margin: 0 !important;
  border: 0 !important;
  border-collapse: collapse !important;
  border-spacing: 0 !important;
  background: #ffffff !important;
  color: #242b31 !important;
  text-align: left !important;
  table-layout: auto !important;
}
.wakefield-comparison .wf-table caption {
  padding: 12px 14px !important;
  border: 0 !important;
  background: #edf4f8 !important;
  color: #123b5d !important;
  font-weight: 700 !important;
  text-align: left !important;
}
.wakefield-comparison .wf-table thead,
.wakefield-comparison .wf-table tbody,
.wakefield-comparison .wf-table tr {
  border: 0 !important;
}
.wakefield-comparison .wf-table th {
  padding: 14px 12px !important;
  border: 0 !important;
  background: #1f4e79 !important;
  color: #ffffff !important;
  font-family: Arial, Helvetica, sans-serif !important;
  font-size: 16px !important;
  font-weight: 700 !important;
  line-height: 1.4 !important;
  text-align: left !important;
  text-transform: none !important;
  vertical-align: top !important;
}
.wakefield-comparison .wf-table td {
  padding: 13px 12px !important;
  border: 0 !important;
  border-top: 1px solid #d7e0e7 !important;
  background: transparent !important;
  color: #242b31 !important;
  font-size: 16px !important;
  line-height: 1.5 !important;
  text-align: left !important;
  vertical-align: top !important;
}
.wakefield-comparison .wf-table tbody tr:nth-child(even) {
  background: #f8fafb !important;
}
.wakefield-comparison .wf-table td:first-child,
.wakefield-comparison .wf-table td:nth-child(2) {
  font-weight: 700 !important;
  white-space: nowrap !important;
}
.wakefield-comparison .wf-note {
  margin-top: 8px !important;
  color: #5b6872 !important;
  font-size: 0.92rem !important;
}
.wakefield-comparison .wf-steps {
  margin: 12px 0 0 !important;
  padding-left: 24px !important;
  color: #242b31 !important;
  list-style-position: outside !important;
}
.wakefield-comparison .wf-steps li {
  margin: 0 0 10px !important;
  padding-left: 4px !important;
  color: #242b31 !important;
  font-size: 16px !important;
  line-height: 1.65 !important;
}
