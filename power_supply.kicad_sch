	(text "U20: +5V_RAW -> +5V (+5.1 V, 3 A) TPS54360B, 400 kHz, UVLO start 5.9 V / stop 5.5 V, Rc 33.2K / Cc 33nF / Cp 470pF"
		(exclude_from_sim no)
		(at 359.41 41.91 0)
