+        trace = fopen(name, "w");
+        if (trace) fprintf(trace, "time,kind,address,data,mask\n");
+      }
+    }
+    if (trace && ((address >= 0x3fe0 && address <= 0x3fe6) || address == 0x3fff || address == 0x3fd4))
+      fprintf(trace, "%.9f,W,%04x,%02x,ff\n", timer_get_time(), address, data & 255);
+  }
