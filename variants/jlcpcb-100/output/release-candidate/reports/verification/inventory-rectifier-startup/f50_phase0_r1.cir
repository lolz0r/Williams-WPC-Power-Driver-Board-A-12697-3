Rp20a p20a a20a 0.05
Rq20a q20a b20a 0.05
Vs20a a20a ab20a 0
D120aa ab20a xaD120a J100ONLEG_A
VD120aa xaD120a dc20a 0
D120ab ab20a xbD120a J100ONLEG_B
VD120ab xbD120a dc20a 0
D220aa b20a xaD220a J100ONLEG_A
VD220aa xaD220a dc20a 0
D220ab b20a xbD220a J100ONLEG_B
VD220ab xbD220a dc20a 0
D320aa 0 xaD320a J100ONLEG_A
VD320aa xaD320a ab20a 0
D320ab 0 xbD320a J100ONLEG_B
VD320ab xbD320a ab20a 0
D420aa 0 xaD420a J100ONLEG_A
VD420aa xaD420a b20a 0
D420ab 0 xbD420a J100ONLEG_B
VD420ab xbD420a b20a 0
C20a dc20a 0 11280.0u
Bl20a dc20a 0 I = (time > 60m) ? 2.5 : 0
