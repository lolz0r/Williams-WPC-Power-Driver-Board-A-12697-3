.model J100ON20H D(Is=2e-7 N=1.05 Rs=.0045 Cjo=1400p Bv=100 Ibv=1m)


.model J100ONLEG_A D(Is=1e-7 N=1.05 Rs=.0072 Cjo=700p Bv=100 Ibv=1m)
.model J100ONLEG_B D(Is=1e-8 N=1.05 Rs=.0108 Cjo=700p Bv=100 Ibv=1m)

.options method=gear reltol=.001 minbreak=1p klu
.tran 1u 50m 0 1u uic
.control
run
let sim_end=time[length(time)-1]
print sim_end
let ia_5a=abs(i(Vs5a))
let i2_5a=ia_5a*ia_5a
meas tran peak_5a MAX ia_5a from=0 to=50m
meas tran i2t_5a INTEG i2_5a from=0 to=50m
let ia_20a=abs(i(Vs20a))
let i2_20a=ia_20a*ia_20a
meas tran peak_20a MAX ia_20a from=0 to=50m
meas tran i2t_20a INTEG i2_20a from=0 to=50m
let ia_12b=abs(i(Vs12b))
let i2_12b=ia_12b*ia_12b
meas tran peak_12b MAX ia_12b from=0 to=50m
meas tran i2t_12b INTEG i2_12b from=0 to=50m
let il_5a_a=abs(i(VD15aa))
let il2_5a_a=il_5a_a*il_5a_a
meas tran legpeak_5a_a MAX il_5a_a from=0 to=50m
meas tran legi2t_5a_a INTEG il2_5a_a from=0 to=50m
let il_5a_b=abs(i(VD15ab))
let il2_5a_b=il_5a_b*il_5a_b
meas tran legpeak_5a_b MAX il_5a_b from=0 to=50m
meas tran legi2t_5a_b INTEG il2_5a_b from=0 to=50m
let il_20a_a=abs(i(VD120aa))
let il2_20a_a=il_20a_a*il_20a_a
meas tran legpeak_20a_a MAX il_20a_a from=0 to=50m
meas tran legi2t_20a_a INTEG il2_20a_a from=0 to=50m
let il_20a_b=abs(i(VD120ab))
let il2_20a_b=il_20a_b*il_20a_b
meas tran legpeak_20a_b MAX il_20a_b from=0 to=50m
meas tran legi2t_20a_b INTEG il2_20a_b from=0 to=50m
let il_12b_a=abs(i(VD112ba))
let il2_12b_a=il_12b_a*il_12b_a
meas tran legpeak_12b_a MAX il_12b_a from=0 to=50m
meas tran legi2t_12b_a INTEG il2_12b_a from=0 to=50m
let il_12b_b=abs(i(VD112bb))
let il2_12b_b=il_12b_b*il_12b_b
meas tran legpeak_12b_b MAX il_12b_b from=0 to=50m
meas tran legi2t_12b_b INTEG il2_12b_b from=0 to=50m
.endc
.end
