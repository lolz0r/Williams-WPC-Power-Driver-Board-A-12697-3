	)
	(text "General purpose drivers (sol. 25-28): IPD90N10S4L-06 DPAK, latch U2 output HIGH = ON, clocked by /SOL 1 (J113-12). S3M tie-back diode cathodes are brought out\nto J122 pins 5,6,8,9 so the harness can tie them to the supply actually used (+50V coil or +20V flasher).\nOutputs J122 (playfield, key pin 7), J123 (backbox, key pin 2) and J124 (cabinet, key pin 4) as on the A-12697. U2 bits 4-7 unused."
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "beccf6ae-679a-4390-9050-ba4bb319f1d8")
	)
